{
    "name": "cpehub/php-telnet",
    "description": "PHP Telnet Client",
    "homepage": "https://github.com/cpehub/php-telnet",
    "version": "v1.0.2",
    "license": "MIT",
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "ext-sockets": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "authors": [
        {
            "name": "skrip42",
            "email": "skrip42@gmail.com"
        },
        {
            "name": "Cpehub",
            "email": "contato@cpehub.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Cpehub\\Telnet\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cpehub\\Telnet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    }
}
